            <div class="card-body text-center">
                <h5 class="card-title">Product Name 2</h5>
            </div>
        </div>
    </div>

    <!--San pham 3-->
    <div class="col-md-3">
        <div class="card mb-4">
            <img src="~/images/product3.jpg"
                 class="card-img-top"
                 alt="Product 1"
                 style="height: 190px; object-fit: contain;" />

            <div class="card-body text-center">
                <h5 class="card-title">Product Name 3</h5>
            </div>
