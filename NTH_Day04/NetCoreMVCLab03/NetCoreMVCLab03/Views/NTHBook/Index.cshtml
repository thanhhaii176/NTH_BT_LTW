@model IEnumerable<NetCoreMVCLab03.Models.Book>

@{
    ViewData["Title"] = "Index";
}
<h2>Danh sách các cuốn sách</h2>
<!--Hien thi cac ComboBox tren form-->
<form action="Index" method="POST" style="display: flex; align-items: center; gap: 5px; margin-bottom: 15px">
        <select name="AuthorId" class="form-select" asp-items="@ViewBag.authors" style="width: 250px">
            <option value="">Chọn tác giả</option>
        </select>
        <select name="GenreId" class="form-select" asp-items="@ViewBag.genres" style="width: 250px">
            <option value="">Chọn thể loại</option>
        </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a asp-action="Create" class="btn btn-danger">Thêm mới</a>
</form>
<hr />
<!--Hien thi danh sach cac cuon sach-->

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.AuthorId</td>
                <td>@book.GenreId</td>
                <td>@book.Price</td>
                <td>
                    <img src="@book.Image" alt="@book.Title" width="40"/>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
