@model List<Demo_Lab.Models.Category>

<div class="card">
    <div class="card-header bg-primary text-white">
        Danh mục sản phẩm
    </div>

    <div class="list-group list-group-flush">
        @foreach (var category in Model)
        {
            <a href="#" class="list-group-item list-group-item-action">
                @category.Name
            </a>
        }
    </div>
</div>