@model NetCoreMVCLAB05.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<h1>Sửa sản phẩm</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Image" class="control-label">Ảnh hiện tại</label>
                <br />
                @if (!string.IsNullOrEmpty(Model.Image))
                    {
                    <img src="~/product/@Model.Image" alt="@Model.Name" width="150" class="img-thumbnail"/>
                    }
                else
                    {
                        <span>Chưa có ảnh</span>
                    }    
            </div>
            <div class="form-group mb-3">
                <label class="control-label">
                    Chọn ảnh mới
                </label>

                <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.jfif" />

                <small class="text-muted">
                    Không chọn ảnh nếu muốn giữ ảnh hiện tại.
                </small>

                <span asp-validation-for="Image"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">Giá sản phẩm</label>
                <input asp-for="Price" type="number" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SalePrice" class="control-label">Giá khuyến mãi</label>
                <input asp-for="SalePrice" type="number" class="form-control" />
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="control-label">Danh mục</label>
                <select asp-for="CategoryId" class="form-control">
                    <option value="0">---Chọn danh mục---</option>
                        @foreach(var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
