@model NetCoreMVCLAB05.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var categories = NetCoreMVCLAB05.Controllers.CategoryController.GetCategories();
    var category = categories.FirstOrDefault(x => x.Id == Model.CategoryId);
}

<h1>Chi tiết sản phẩm</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Model.Name
        </dd>
        <dt class = "col-sm-2">
            Hình ảnh
        </dt>
        <dd class = "col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="~/products/@Model.Image" alt="@Model.Name" width="200" class="img-thumbnail"/>
        }
        else
        {
            <span>Không có hình ảnh nào.</span>
        }
    </dd>
    
        <dt class = "col-sm-2">
            Giá sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("N0") VNĐ
        </dd>
    
        <dt class = "col-sm-2">
            Giá khuyến mãi
        </dt>
        <dd class = "col-sm-10">
            @Model.SalePrice.ToString("N0") VNĐ
        </dd>
    
        <dt class = "col-sm-2">
            Mô tả
        </dt>
        <dd class = "col-sm-10">
            @Model.Description
        </dd>
    
        <dt class = "col-sm-2">
            Danh mục
        </dt>
        <dd class = "col-sm-10">
            @(category?.Name ?? "Không xác định")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
