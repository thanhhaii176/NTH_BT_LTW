@model NetCoreMVCLAB05.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    var categories = NetCoreMVCLAB05.Controllers.CategoryController.GetCategories();
    var cateory = categories.FirstOrDefault(x => x.Id == Model.CategoryId);
}

<h1>Xóa sản phẩm</h1>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này?</h3>
<div>
    <h4>Thông tin sản phẩm</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Model.Name
        </dd>

        <dt class = "col-sm-2">
            Hình ảnh
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="~/products/@Model.Image" alt="@Model.Name" width="150" class="img-thumbnail"/>
            }
            else
            {
                <span>Không có hình ảnh</span>
            }
        </dd>
        <dt class = "col-sm-2">
            Giá sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("N0") VNĐ
        </dd>
        <dt class = "col-sm-2">
            Giá khuyến mãi
        </dt>
        <dd class = "col-sm-10">
            @Model.SalePrice.ToString("N0") VNĐ
        </dd>
        <dt class = "col-sm-2">
            Mô tả
        </dt>
        <dd class = "col-sm-10">
            @Model.Description
        </dd>
        <dt class = "col-sm-2">
            Danh mục
        </dt>
        <dd class = "col-sm-10">
            @(cateory?.Name ?? "Không xác định")
        </dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xóa sản phẩm</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>
