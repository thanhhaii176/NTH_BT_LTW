@model Lesson08DB_First.Models.Category

@{
    ViewData["Title"] = "Delete";
}

<h1>Xóa Category</h1>

<h3>Bạn có chắc chắn muốn xóa Category này không?</h3>
<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Mã Category
        </dt>
        <dd class = "col-sm-10">
            @Model.CategoryId
        </dd>
        <dt class = "col-sm-2">
            Tên Category
        </dt>
        <dd class = "col-sm-10">
            @Model.CategoryName
        </dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
