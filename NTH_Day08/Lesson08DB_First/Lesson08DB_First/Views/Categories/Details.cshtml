@model Lesson08DB_First.Models.Category

@{
    ViewData["Title"] = "Details";
}

<h1>Chi tiết Category</h1>

<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Mã Category
        </dt>
        <dd class = "col-sm-10">
            @Model.CategoryId
        </dd>
        <dt class = "col-sm-2">
            Tên Category
        </dt>
        <dd class = "col-sm-10">
            @Model.CategoryName
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-categoryid="@Model?.CategoryId" class="btn btn-warning">Sửa</a> 
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
