@model Lesson08DB_First.Models.OrderDetail

@{
    ViewData["Title"] = "Xóa chi tiết đơn hàng";
}

<h1>Xóa chi tiết đơn hàng</h1>

<h3>Bạn có chắc chắn muốn xóa chi tiết này không?</h3>
<div>
    <h4>Thông tin chi tiết đon hàng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            Mã đơn hàng
        </dt>
        <dd class = "col-sm-9">
            @Model.OrderId
        </dd>
        <dt class = "col-sm-3">
            Mã sách
        </dt>
        <dd class = "col-sm-9">
            @Model.BookId
        </dd>
        <dt class = "col-sm-3">
            Tên sách
        </dt>
        <dd class = "col-sm-9">
            @Model.Book?.Title
        </dd>
        <dt class = "col-sm-3">
            Số lượng
        </dt>
        <dd class = "col-sm-9">
            @Model.Quantity
        </dd>
        <dt class = "col-sm-3">
            Đơn giá
        </dt>
        <dd class = "col-sm-9">
            @Model.Price đ
        </dd>
        <dt class = "col-sm-3">
            Thành tiền
        </dt>
        <dd class = "col-sm-9">
            @Model.TotalMoney đ
        </dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="orderdetailid" value="@Model.OrderDetailId" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
